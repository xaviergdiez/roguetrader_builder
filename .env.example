# Copy to .env.local and fill in. Only needed for `vercel dev` and deploys —
# `npm run dev` runs without any of it (stubbed sign-in, roster in localStorage).
#
# NEVER put real values in this file. It is the one .env the .gitignore lets
# through (see the `!.env.example` line), so anything here gets published.
# `vercel env pull` writes to .env.local, which is ignored — leave it there.

# Upstash Redis. Either pair works: these two, or the KV_REST_API_URL /
# KV_REST_API_TOKEN pair that Vercel's Upstash integration provisions.
# See redisConfigFromEnv() in lib/storage.js.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google sign-in. The redirect URI is derived from the request host, so every
# host you sign in from must be registered on the OAuth client:
#   https://<your-project>.vercel.app/api/auth/callback
#   http://localhost:3000/api/auth/callback   (for `vercel dev`)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The only address allowed to sign in. Blank or unset lets in ANY Google
# account — set it unless you mean the app to be open.
OWNER_EMAIL=

# Portrait generation (api/generate-avatar.js). Without it that endpoint
# returns 503 and the GenAI button says so; everything else works regardless.
# The endpoint is behind sign-in because each call costs money.
GEMINI_API_KEY=
