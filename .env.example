# Copy to .env.local and fill in. Only needed for `vercel dev` and deploys —
# `npm run dev` runs without any of it (stubbed sign-in, roster in localStorage).

# Upstash Redis. Redis.fromEnv() reads exactly these two names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google sign-in. Authorized redirect URI: <your app URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The only address allowed to sign in. Leave blank to let any Google account in.
OWNER_EMAIL=
